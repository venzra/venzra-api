{
    "name": "venzra-api",
    "version": "1.0.0",
    "author": "SYSEN LIMITED",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "serverless offline start --stage dev",
        "test:ci": "tsc && nyc cucumber-js --require ./test ./test/features --exit",
        "test:local": "mongo venzra-test --eval \"db.dropDatabase()\" && DB_URI=mongodb://localhost/venzra-test npm run test:ci",
        "deploy:prod": "serverless create_domain --stage production && serverless deploy -v --stage production",
        "deploy:test": "serverless create_domain --stage test && serverless deploy -v --stage test"
    },
    "dependencies": {
        "aws-serverless-express": "3.3.5",
        "body-parser": "1.18.3",
        "cookie-parser": "1.4.3",
        "cors": "2.8.4",
        "ejs": "2.6.1",
        "express": "4.16.4",
        "helmet": "3.14.0",
        "jwt-simple": "0.5.5",
        "moment": "2.22.2",
        "mongoose": "5.3.9",
        "stripe": "6.13.0",
        "uuid": "3.3.2",
        "winston": "3.1.0",
        "zxcvbn": "4.4.2"
    },
    "devDependencies": {
        "@types/aws-serverless-express": "3.3.0",
        "@types/cookie-parser": "1.4.1",
        "@types/cors": "2.8.4",
        "@types/ejs": "2.6.0",
        "@types/express": "4.16.0",
        "@types/helmet": "0.0.42",
        "@types/jwt-simple": "0.5.33",
        "@types/moment": "2.13.0",
        "@types/mongoose": "5.3.0",
        "@types/node": "10.12.2",
        "@types/sharp": "0.21.0",
        "@types/stripe": "6.0.3",
        "@types/uuid": "3.4.4",
        "@types/winston": "2.4.4",
        "@types/zxcvbn": "4.4.0",
        "aws-sdk": "2.348.0",
        "chai": "4.2.0",
        "cucumber": "5.0.2",
        "nock": "10.0.2",
        "nyc": "13.1.0",
        "serverless": "1.32.0",
        "serverless-domain-manager": "2.6.5",
        "serverless-offline": "3.31.0",
        "serverless-plugin-typescript": "1.1.5",
        "sharp": "0.21.0",
        "supertest": "3.3.0",
        "typescript": "3.1.6"
    }
}
