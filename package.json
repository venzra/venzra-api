{
    "name": "venzra-api",
    "version": "1.0.0",
    "author": "SYSEN LIMITED",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "serverless offline start --stage dev",
        "test": "nyc serverless offline start --port=3001 --stage test --exec \"cucumber-js ./test/features --require ./test --format ./node_modules/cucumber-pretty\"",
        "test:local": "mongo venzra-test --eval \"db.dropDatabase()\" && DB_URI=mongodb://localhost/venzra-test npm run test",
        "deploy": "serverless create_domain --stage production && serverless deploy -v --stage production",
        "deploy:test": "serverless create_domain --stage test && serverless deploy -v --stage test"
    },
    "dependencies": {
        "ejs": "2.6.1",
        "moment": "2.22.1",
        "mongoose": "5.1.3",
        "uuid": "3.2.1"
    },
    "devDependencies": {
        "aws-sdk": "2.247.1",
        "chai": "4.1.2",
        "cucumber": "3.2.1",
        "cucumber-pretty": "1.4.4",
        "nyc": "11.8.0",
        "request": "2.87.0",
        "request-promise": "4.2.2",
        "serverless": "1.27.3",
        "serverless-domain-manager": "2.4.0",
        "serverless-offline": "3.24.3"
    }
}
