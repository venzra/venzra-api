{
    "name": "venzra-api",
    "version": "1.0.0",
    "author": "SYSEN LIMITED",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "serverless offline start --stage dev",
        "test:ci": "tsc && nyc cucumber-js --require ./test ./test/features --exit",
        "test:local": "mongo venzra-test --eval \"db.dropDatabase()\" && DB_URI=mongodb://localhost/venzra-test npm run test:ci",
        "deploy:prod": "serverless create_domain --stage production && serverless deploy -v --stage production",
        "deploy:test": "serverless create_domain --stage test && serverless deploy -v --stage test"
    },
    "dependencies": {
        "aws-serverless-express": "3.2.0",
        "body-parser": "1.18.3",
        "cookie-parser": "1.4.3",
        "cors": "2.8.4",
        "ejs": "2.6.1",
        "express": "4.16.3",
        "helmet": "3.13.0",
        "jwt-simple": "0.5.1",
        "moment": "2.22.2",
        "mongoose": "5.2.5",
        "stripe": "6.3.0",
        "uuid": "3.3.2",
        "winston": "3.0.0",
        "zxcvbn": "4.4.2"
    },
    "devDependencies": {
        "@types/aws-serverless-express": "3.0.1",
        "@types/cookie-parser": "1.4.1",
        "@types/cors": "2.8.4",
        "@types/ejs": "2.6.0",
        "@types/express": "4.16.0",
        "@types/helmet": "0.0.38",
        "@types/jwt-simple": "0.5.33",
        "@types/moment": "2.13.0",
        "@types/mongoose": "5.2.2",
        "@types/node": "10.5.3",
        "@types/sharp": "0.17.9",
        "@types/stripe": "5.0.19",
        "@types/uuid": "3.4.3",
        "@types/winston": "2.3.9",
        "@types/zxcvbn": "4.4.0",
        "aws-sdk": "2.280.1",
        "chai": "4.1.2",
        "cucumber": "4.2.1",
        "nock": "9.4.3",
        "nyc": "12.0.2",
        "serverless": "1.28.0",
        "serverless-domain-manager": "2.6.0",
        "serverless-offline": "3.25.6",
        "serverless-plugin-typescript": "1.1.5",
        "sharp": "0.20.5",
        "supertest": "3.1.0",
        "typescript": "2.9.2"
    }
}
