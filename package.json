{
    "name": "venzra-api",
    "version": "1.0.0",
    "author": "SYSEN LIMITED",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "start": "serverless offline start --stage dev",
        "test:ci": "tsc && nyc cucumber-js --require ./test ./test/features --exit",
        "test:local": "mongo venzra-test --eval \"db.dropDatabase()\" && DB_URI=mongodb://localhost/venzra-test npm run test:ci",
        "deploy:prod": "serverless create_domain --stage production && serverless deploy -v --stage production",
        "deploy:test": "serverless create_domain --stage test && serverless deploy -v --stage test"
    },
    "dependencies": {
        "aws-serverless-express": "3.3.5",
        "body-parser": "1.18.3",
        "cookie-parser": "1.4.4",
        "cors": "2.8.5",
        "ejs": "2.6.1",
        "express": "4.16.4",
        "helmet": "3.16.0",
        "jwt-simple": "0.5.5",
        "moment": "2.24.0",
        "mongoose": "5.4.19",
        "request": "2.88.0",
        "request-promise-native": "1.0.7",
        "sharp": "0.22.0",
        "stripe": "6.28.0",
        "uuid": "3.3.2",
        "winston": "3.2.1",
        "zxcvbn": "4.4.2"
    },
    "devDependencies": {
        "@types/aws-serverless-express": "3.3.0",
        "@types/cookie-parser": "1.4.1",
        "@types/cors": "2.8.4",
        "@types/ejs": "2.6.3",
        "@types/express": "4.16.1",
        "@types/helmet": "0.0.43",
        "@types/jwt-simple": "0.5.33",
        "@types/moment": "2.13.0",
        "@types/mongoose": "5.3.23",
        "@types/node": "10.12.9",
        "@types/request": "2.48.1",
        "@types/request-promise-native": "1.0.15",
        "@types/sharp": "0.22.0",
        "@types/stripe": "6.25.6",
        "@types/uuid": "3.4.4",
        "@types/winston": "2.4.4",
        "@types/zxcvbn": "4.4.0",
        "aws-sdk": "2.427.0",
        "chai": "4.2.0",
        "cucumber": "5.1.0",
        "nock": "10.0.6",
        "nyc": "13.3.0",
        "serverless": "1.39.1",
        "serverless-domain-manager": "3.2.1",
        "serverless-offline": "4.9.2",
        "serverless-plugin-typescript": "1.1.5",
        "supertest": "4.0.2",
        "typescript": "3.3.3"
    }
